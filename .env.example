# Trusted Bash configuration. Exported command-line variables take precedence.
# Read the Minecraft EULA and accept it explicitly at first start.
BOTS=64
BOT_PREFIX=bcmc
BCMC_MODE=train
SEED=71683

# Offline mode has NO account authentication. This ACK adds no security.
# Restrict TCP 25565 to trusted LAN/VPN/firewall sources before starting.
SERVER_PORT=25565
BIND_ADDRESS=0.0.0.0
OFFLINE_ACCESS_ACK=true

JAVA_HEAP_GB=6
FOLIA_THREADS=6
# Keep actor chunk traffic small; observer distance is independent.
VIEW_DISTANCE=3
SIMULATION_DISTANCE=3
BOT_VIEW_DISTANCE=3
SPECTATOR_VIEW_DISTANCE=12
WORLD_DIAMETER=512
MIN_FREE_GB=10
ACTION_HZ=5
ROLLOUT_STEPS=64
# Default total quota is BOTS * ROLLOUT_STEPS (4096 at 64 bots).
# Collection finishes complete episodes before publishing a new policy.
# BATCH_SAMPLES=4096
BOT_JOIN_DELAY_MS=400
COHORT_TIMEOUT_SECONDS=600
RUN_SECONDS=0
CARGO_BUILD_JOBS=2
STARTUP_TIMEOUT_SECONDS=600
# Fixed Minecraft 1.21.11 / Folia 14, pinned in pins/folia.lock.
# JAVA_BIN=/absolute/path/to/jdk21/bin/java
# javac and jar from the same Java 21 JDK must be available.
