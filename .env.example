# This is the complete current launcher format. Do not copy an older .env.
# Read https://aka.ms/MinecraftEULA and change this only after accepting it.
EULA=false
ACADEMY=academy
BOTS=auto
HEAP_GB=auto
REGION_THREADS=auto
INFERENCE_THREADS=auto
LEARNER_THREADS=auto
PORT=25565
BIND_ADDRESS=0.0.0.0
# NPCs do not log in. Online authentication can remain enabled for humans.
ONLINE_MODE=true
OFFLINE_ACCESS_ACK=false
SEED=7
# Optional absolute path to the JDK java executable:
# JAVA_BIN=/path/to/jdk/bin/java
