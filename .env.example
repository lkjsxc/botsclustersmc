# Trusted Bash configuration. Exported command-line variables take precedence.
# EULA is deliberately not accepted here. Start: EULA=true ./start.sh
BOTS=32
BOT_PREFIX=bcmc
BCMC_MODE=train
SEED=71683

# Requested public bind. Offline mode has NO account authentication.
# Restrict TCP 25565 with a firewall/VPN before starting. This ACK adds no security.
SERVER_PORT=25565
BIND_ADDRESS=0.0.0.0
OFFLINE_ACCESS_ACK=true

JAVA_HEAP_GB=6
FOLIA_THREADS=6
VIEW_DISTANCE=3
SIMULATION_DISTANCE=3
WORLD_DIAMETER=512
MIN_FREE_GB=10
ACTION_HZ=5
ROLLOUT_STEPS=64
# BATCH_SAMPLES=2048
RUN_SECONDS=0
CARGO_BUILD_JOBS=2
# Fixed Minecraft 1.21.11 / Folia 14, pinned in pins/folia.lock.
# JAVA_BIN=/absolute/path/to/jdk21/bin/java
# javac and jar from the same JDK21 must be available.

# Maximum startup wait; plugin failures are reported immediately.
STARTUP_TIMEOUT_SECONDS=600
