# Optional USER unit: ~/.config/systemd/user/botsclustersmc.service
# Edit WorkingDirectory/ExecStart to your absolute extracted directory.
[Unit]
Description=botsclustersmc Folia reinforcement-learning experiment
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=900
StartLimitBurst=2
[Service]
Type=simple
WorkingDirectory=%h/botsclustersmc
ExecStart=%h/botsclustersmc/start.sh
Restart=on-failure
RestartSec=60
TimeoutStopSec=300
KillMode=mixed
MemoryHigh=10G
MemoryMax=11G
CPUQuota=1400%
TasksMax=512
UMask=0077
NoNewPrivileges=true
[Install]
WantedBy=default.target
